@prefix chm:     <https://example.org/chm#> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix chsample: <https://example.org/clarkhall/sample/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

####################################################################
# Clark–Hall morphology – working RDF model
# Focus: strong verbs, morphology only (no TEI print details)
# Notes:
#  - Use chsample: for LexicalEntry IRIs and chsample: for Form IRIs.
#  - Form IRIs use underscore naming (no '/' or '#') for Turtle/Protégé compatibility.
####################################################################

####################################################################
# Lemma: bīdan (Strong Verb Class I)
####################################################################

chsample:biidan a ontolex:LexicalEntry, chm:StrongVerb, chm:StrongVerbI ;
  rdfs:label "bīdan"@ang ;
  ontolex:canonicalForm chsample:biidan_inf ;
  ontolex:otherForm
    chsample:biidan_pret-3sg ,
    chsample:biidan_pret-pl_1 ,
    chsample:biidan_pret-pl_2 ,
    chsample:biidan_pres-2sg_1 ,
    chsample:biidan_pres-2sg_2 ,
    chsample:biidan_pres-2sg_3 ,
    chsample:biidan_pres-3sg .

# infinitive
chsample:biidan_inf a ontolex:Form ;
  ontolex:writtenRep "bīdan"@ang ;
  lexinfo:verbFormMood lexinfo:infinitive .

# pret. 3 sg. (bād)
chsample:biidan_pret-3sg a ontolex:Form ;
  ontolex:writtenRep "bād"@ang ;
  lexinfo:tense lexinfo:past ;
  lexinfo:person lexinfo:thirdPerson ;
  lexinfo:number lexinfo:singular ;
  lexinfo:verbFormMood lexinfo:indicative .

# pret. pl. variant 1 (beodan)
chsample:biidan_pret-pl_1 a ontolex:Form ;
  ontolex:writtenRep "beodan"@ang ;
  lexinfo:tense lexinfo:past ;
  lexinfo:number lexinfo:plural ;
  lexinfo:verbFormMood lexinfo:indicative .

# pret. pl. variant 2 (bidon)
chsample:biidan_pret-pl_2 a ontolex:Form ;
  ontolex:writtenRep "bidon"@ang ;
  lexinfo:tense lexinfo:past ;
  lexinfo:number lexinfo:plural ;
  lexinfo:verbFormMood lexinfo:indicative .

# pres. 2 sg. variant 1 (bīst)
chsample:biidan_pres-2sg_1 a ontolex:Form ;
  ontolex:writtenRep "bīst"@ang ;
  lexinfo:tense lexinfo:present ;
  lexinfo:person lexinfo:secondPerson ;
  lexinfo:number lexinfo:singular ;
  lexinfo:verbFormMood lexinfo:indicative .

# pres. 2 sg. variant 2 (bīdst)
chsample:biidan_pres-2sg_2 a ontolex:Form ;
  ontolex:writtenRep "bīdst"@ang ;
  lexinfo:tense lexinfo:present ;
  lexinfo:person lexinfo:secondPerson ;
  lexinfo:number lexinfo:singular ;
  lexinfo:verbFormMood lexinfo:indicative .

# pres. 2 sg. variant 3 (bītst)
chsample:biidan_pres-2sg_3 a ontolex:Form ;
  ontolex:writtenRep "bītst"@ang ;
  lexinfo:tense lexinfo:present ;
  lexinfo:person lexinfo:secondPerson ;
  lexinfo:number lexinfo:singular ;
  lexinfo:verbFormMood lexinfo:indicative .

# pres. 3 sg. (bīt)
chsample:biidan_pres-3sg a ontolex:Form ;
  ontolex:writtenRep "bīt"@ang ;
  lexinfo:tense lexinfo:present ;
  lexinfo:person lexinfo:thirdPerson ;
  lexinfo:number lexinfo:singular ;
  lexinfo:verbFormMood lexinfo:indicative .


####################################################################
# Lemma: cēosan (Strong Verb Class IIa)
# Clark–Hall has ± on the lemma => found with and without ge-
####################################################################

chsample:ceosan a ontolex:LexicalEntry, chm:StrongVerb, chm:StrongVerbIIa ;
  rdfs:label "cēosan"@ang ;
  ontolex:canonicalForm chsample:ceosan_inf ;
  ontolex:otherForm
    chsample:ceosan_inf_2 ,
    chsample:ceosan_pret-3sg_1 ,
    chsample:ceosan_pret-3sg_2 ,
    chsample:ceosan_pret-3sg_3 ,
    chsample:ceosan_pret-pl ,
    chsample:ceosan_pp_1 ,
    chsample:ceosan_pp_2 ,
    chsample:ceosan_pres-3sg_1 ,
    chsample:ceosan_pres-3sg_2 ,
    chsample:ceosan_pres-3sg_3 ,
    chsample:ceosan_pres-3sg_4 ,
    chsample:ceosan_pres-3sg_5 .

# infinitive (unprefixed + ge- prefixed variant)
chsample:ceosan_inf a ontolex:Form ;
  ontolex:writtenRep "cēosan"@ang ;
  lexinfo:verbFormMood lexinfo:infinitive .

chsample:ceosan_inf_2 a ontolex:Form ;
  ontolex:writtenRep "gecēosan"@ang ;
  lexinfo:verbFormMood lexinfo:infinitive .

# preterite 3 sg. (variants: cēas, cǣs, cēs)
chsample:ceosan_pret-3sg_1 a ontolex:Form ;
  ontolex:writtenRep "cēas"@ang ;
  lexinfo:tense lexinfo:past ;
  lexinfo:person lexinfo:thirdPerson ;
  lexinfo:number lexinfo:singular ;
  lexinfo:verbFormMood lexinfo:indicative .

chsample:ceosan_pret-3sg_2 a ontolex:Form ;
  ontolex:writtenRep "cǣs"@ang ;
  lexinfo:tense lexinfo:past ;
  lexinfo:person lexinfo:thirdPerson ;
  lexinfo:number lexinfo:singular ;
  lexinfo:verbFormMood lexinfo:indicative .

chsample:ceosan_pret-3sg_3 a ontolex:Form ;
  ontolex:writtenRep "cēs"@ang ;
  lexinfo:tense lexinfo:past ;
  lexinfo:person lexinfo:thirdPerson ;
  lexinfo:number lexinfo:singular ;
  lexinfo:verbFormMood lexinfo:indicative .

# preterite plural (curon)
chsample:ceosan_pret-pl a ontolex:Form ;
  ontolex:writtenRep "curon"@ang ;
  lexinfo:tense lexinfo:past ;
  lexinfo:number lexinfo:plural ;
  lexinfo:verbFormMood lexinfo:indicative .

# past participle (±coren => coren and gecoren)
chsample:ceosan_pp_1 a ontolex:Form ;
  ontolex:writtenRep "coren"@ang ;
  lexinfo:verbFormMood lexinfo:participle ;
  lexinfo:tense lexinfo:past .

chsample:ceosan_pp_2 a ontolex:Form ;
  ontolex:writtenRep "gecoren"@ang ;
  lexinfo:verbFormMood lexinfo:participle ;
  lexinfo:tense lexinfo:past .

# present 3 sg. variants
chsample:ceosan_pres-3sg_1 a ontolex:Form ;
  ontolex:writtenRep "cīest"@ang ;
  lexinfo:tense lexinfo:present ;
  lexinfo:person lexinfo:thirdPerson ;
  lexinfo:number lexinfo:singular ;
  lexinfo:verbFormMood lexinfo:indicative .

chsample:ceosan_pres-3sg_2 a ontolex:Form ;
  ontolex:writtenRep "cīesð"@ang ;
  lexinfo:tense lexinfo:present ;
  lexinfo:person lexinfo:thirdPerson ;
  lexinfo:number lexinfo:singular ;
  lexinfo:verbFormMood lexinfo:indicative .

chsample:ceosan_pres-3sg_3 a ontolex:Form ;
  ontolex:writtenRep "cīst"@ang ;
  lexinfo:tense lexinfo:present ;
  lexinfo:person lexinfo:thirdPerson ;
  lexinfo:number lexinfo:singular ;
  lexinfo:verbFormMood lexinfo:indicative .

chsample:ceosan_pres-3sg_4 a ontolex:Form ;
  ontolex:writtenRep "cȳst"@ang ;
  lexinfo:tense lexinfo:present ;
  lexinfo:person lexinfo:thirdPerson ;
  lexinfo:number lexinfo:singular ;
  lexinfo:verbFormMood lexinfo:indicative .

chsample:ceosan_pres-3sg_5 a ontolex:Form ;
  ontolex:writtenRep "cȳsð"@ang ;
  lexinfo:tense lexinfo:present ;
  lexinfo:person lexinfo:thirdPerson ;
  lexinfo:number lexinfo:singular ;
  lexinfo:verbFormMood lexinfo:indicative .


####################################################################
# Lemma: lūcan (Strong Verb Class IIb)
# Clark–Hall has (±) on the lemma => found with and without ge-
####################################################################

chsample:luucan a ontolex:LexicalEntry, chm:StrongVerb, chm:StrongVerbIIb ;
  rdfs:label "lūcan"@ang ;
  ontolex:canonicalForm chsample:luucan_inf ;
  ontolex:otherForm
    chsample:luucan_inf_2 ,
    chsample:luucan_pret-3sg ,
    chsample:luucan_pp ,
    chsample:luucan_pres-3sg .

# infinitive (unprefixed + ge- prefixed variant)
chsample:luucan_inf a ontolex:Form ;
  ontolex:writtenRep "lūcan"@ang ;
  lexinfo:verbFormMood lexinfo:infinitive .

chsample:luucan_inf_2 a ontolex:Form ;
  ontolex:writtenRep "gelūcan"@ang ;
  lexinfo:verbFormMood lexinfo:infinitive .

# preterite 3 sg. (lēac)
chsample:luucan_pret-3sg a ontolex:Form ;
  ontolex:writtenRep "lēac"@ang ;
  lexinfo:tense lexinfo:past ;
  lexinfo:person lexinfo:thirdPerson ;
  lexinfo:number lexinfo:singular ;
  lexinfo:verbFormMood lexinfo:indicative .

# past participle (locen)
chsample:luucan_pp a ontolex:Form ;
  ontolex:writtenRep "locen"@ang ;
  lexinfo:verbFormMood lexinfo:participle ;
  lexinfo:tense lexinfo:past .

# present 3 sg. (lȳcð)
chsample:luucan_pres-3sg a ontolex:Form ;
  ontolex:writtenRep "lȳcð"@ang ;
  lexinfo:tense lexinfo:present ;
  lexinfo:person lexinfo:thirdPerson ;
  lexinfo:number lexinfo:singular ;
  lexinfo:verbFormMood lexinfo:indicative .

####################################################################
# Paradigm-cell relations (symmetric; one assertion per pair)
####################################################################

# bīst, bīdst, bītst
chsample:biidan_pres-2sg_1 chm:cellmate chsample:biidan_pres-2sg_2,
    chsample:biidan_pres-2sg_3 .
chsample:biidan_pres-2sg_2 chm:cellmate chsample:biidan_pres-2sg_3 .

# beodan, bidon
chsample:biidan_pret-pl_1 chm:cellmate chsample:biidan_pret-pl_2 .

# cēosan, gecēosan
chsample:ceosan_inf chm:cellmate chsample:ceosan_inf_2 .

# coren, gecoren
chsample:ceosan_pp_1 chm:cellmate chsample:ceosan_pp_2 .

# cīest, cīesð, cīst, cȳst, cȳsð
chsample:ceosan_pres-3sg_1 chm:cellmate chsample:ceosan_pres-3sg_2,
    chsample:ceosan_pres-3sg_3,
    chsample:ceosan_pres-3sg_4,
    chsample:ceosan_pres-3sg_5 .
chsample:ceosan_pres-3sg_2 chm:cellmate chsample:ceosan_pres-3sg_3,
    chsample:ceosan_pres-3sg_4,
    chsample:ceosan_pres-3sg_5 .
chsample:ceosan_pres-3sg_3 chm:cellmate chsample:ceosan_pres-3sg_4,
    chsample:ceosan_pres-3sg_5 .
chsample:ceosan_pres-3sg_4 chm:cellmate chsample:ceosan_pres-3sg_5 .

# cēas, cǣs, cēs
chsample:ceosan_pret-3sg_1 chm:cellmate chsample:ceosan_pret-3sg_2,
    chsample:ceosan_pret-3sg_3 .
chsample:ceosan_pret-3sg_2 chm:cellmate chsample:ceosan_pret-3sg_3 .

# lūcan, gelūcan
chsample:luucan_inf chm:cellmate chsample:luucan_inf_2 .


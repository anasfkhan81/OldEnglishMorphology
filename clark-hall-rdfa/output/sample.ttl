        <https://example.org/ch/CAS2.b_im_tst_form> .

<https://example.org/ch/CAS2.b_am_d_1.1.1_sense> a ontolex:LexicalSense ;
    rdfs:label "forced contribution, impost, pledge,"@en .

<https://example.org/ch/CAS2.b_am_d_1.1.2_sense> a ontolex:LexicalSense ;

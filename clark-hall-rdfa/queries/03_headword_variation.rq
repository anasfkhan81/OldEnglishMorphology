PREFIX ex: <https://example.org/source/>
PREFIX chm: <https://example.org/chm#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT DISTINCT ?entry ?chHeadword ?aristaHeadword WHERE {
  << ?entry chm:headword ?chHeadword >> dcterms:source ex:ClarkHall .
  << ?entry chm:headword ?aristaHeadword >> dcterms:source ex:Arista .
  FILTER(?chHeadword != ?aristaHeadword)
}

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix chm: <https://example.org/chm#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@base <http://www.w3.org/2002/07/owl#> .

[ rdf:type owl:Ontology
 ] .

#################################################################
#    Annotation properties
#################################################################

###  http://www.lexinfo.net/ontology/3.0/lexinfo#number
lexinfo:number rdf:type owl:ObjectProperty .


###  http://www.lexinfo.net/ontology/3.0/lexinfo#person
lexinfo:person rdf:type owl:ObjectProperty .


###  http://www.lexinfo.net/ontology/3.0/lexinfo#tense
lexinfo:tense rdf:type owl:ObjectProperty .


###  http://www.lexinfo.net/ontology/3.0/lexinfo#verbFormMood
lexinfo:verbFormMood rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/lemon/ontolex#canonicalForm
ontolex:canonicalForm rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/lemon/ontolex#otherForm
ontolex:otherForm rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/lemon/ontolex#writtenRep
ontolex:writtenRep rdf:type owl:DatatypeProperty .



#################################################################
#    Data properties
#################################################################

###  https://example.org/chm#infinitive_vowel
chm:infinitive_vowel rdf:type owl:DatatypeProperty ;
                     rdfs:label "infinitive vowel"@en .


###  https://example.org/chm#past_part_vowel
chm:past_part_vowel rdf:type owl:DatatypeProperty ;
                    rdfs:label "past participle vowel"@en .


###  https://example.org/chm#pret_pl_vowel
chm:pret_pl_vowel rdf:type owl:DatatypeProperty ;
                  rdfs:label "preterite plural vowel"@en .


###  https://example.org/chm#pret_sing_vowel
chm:pret_sing_vowel rdf:type owl:DatatypeProperty ;
                    rdfs:label "preterite singular vowel"@en .


###  https://example.org/chm#rootVowel
chm:rootVowel rdf:type owl:DatatypeProperty ;
              rdfs:label "root vowel of the stem in this form"@en .


#################################################################
#    Classes
#################################################################

###  http://www.lexinfo.net/ontology/3.0/lexinfo#Verb
lexinfo:Verb rdf:type owl:Class .


###  http://www.w3.org/ns/lemon/ontolex#Form
ontolex:Form rdf:type owl:Class .


###  http://www.w3.org/ns/lemon/ontolex#LexicalEntry
ontolex:LexicalEntry rdf:type owl:Class .


###  http://www.w3.org/ns/shacl#NodeShape
sh:NodeShape rdf:type owl:Class .


###  https://example.org/chm#StrongVerb
chm:StrongVerb rdf:type owl:Class ;
               rdfs:subClassOf lexinfo:Verb ,
                               ontolex:LexicalEntry ;
               rdfs:label "Strong verb (Clark–Hall morphology)"@en .


###  https://example.org/chm#StrongVerbI
chm:StrongVerbI rdf:type owl:Class ;
                rdfs:subClassOf chm:StrongVerb ;
                rdfs:label "Strong verb class I"@en .


###  https://example.org/chm#StrongVerbII
chm:StrongVerbII rdf:type owl:Class ;
                 rdfs:subClassOf chm:StrongVerb ;
                 rdfs:label "Strong verb class II"@en .


###  https://example.org/chm#StrongVerbIII
chm:StrongVerbIII rdf:type owl:Class ;
                  rdfs:subClassOf chm:StrongVerb ;
                  rdfs:label "Strong verb class III"@en .


###  https://example.org/chm#StrongVerbIIIa
chm:StrongVerbIIIa rdf:type owl:Class ;
                   rdfs:subClassOf chm:StrongVerbIII ;
                   rdfs:label "Strong verb class IIIa"@en .


###  https://example.org/chm#StrongVerbIIIb
chm:StrongVerbIIIb rdf:type owl:Class ;
                   rdfs:subClassOf chm:StrongVerbIII ;
                   rdfs:label "Strong verb class IIIb"@en .


###  https://example.org/chm#StrongVerbIIIc
chm:StrongVerbIIIc rdf:type owl:Class ;
                   rdfs:subClassOf chm:StrongVerbIII ;
                   rdfs:label "Strong verb class IIIc"@en .


###  https://example.org/chm#StrongVerbIIId
chm:StrongVerbIIId rdf:type owl:Class ;
                   rdfs:subClassOf chm:StrongVerbIII ;
                   rdfs:label "Strong verb class IIId"@en .


###  https://example.org/chm#StrongVerbIIIe
chm:StrongVerbIIIe rdf:type owl:Class ;
                   rdfs:subClassOf chm:StrongVerbIII ;
                   rdfs:label "Strong verb class IIIe"@en .


###  https://example.org/chm#StrongVerbIIa
chm:StrongVerbIIa rdf:type owl:Class ;
                  rdfs:subClassOf chm:StrongVerbII ;
                  rdfs:label "Strong verb class IIa"@en .


###  https://example.org/chm#StrongVerbIIb
chm:StrongVerbIIb rdf:type owl:Class ;
                  rdfs:subClassOf chm:StrongVerbII ;
                  rdfs:label "Strong verb class IIb"@en .


###  https://example.org/chm#StrongVerbIV
chm:StrongVerbIV rdf:type owl:Class ;
                 rdfs:subClassOf chm:StrongVerb ;
                 rdfs:label "Strong verb class IV"@en .


###  https://example.org/chm#StrongVerbV
chm:StrongVerbV rdf:type owl:Class ;
                rdfs:subClassOf chm:StrongVerb ;
                rdfs:label "Strong verb class V"@en .


###  https://example.org/chm#StrongVerbVI
chm:StrongVerbVI rdf:type owl:Class ;
                 rdfs:subClassOf chm:StrongVerb ;
                 rdfs:label "Strong verb class VI"@en .


###  https://example.org/chm#StrongVerbVII
chm:StrongVerbVII rdf:type owl:Class ;
                  rdfs:subClassOf chm:StrongVerb ;
                  rdfs:label "Strong verb class VII"@en .


###  https://example.org/chm#StrongVerbVIIa
chm:StrongVerbVIIa rdf:type owl:Class ;
                   rdfs:subClassOf chm:StrongVerbVII ;
                   rdfs:label "Strong verb class VIIa"@en .


###  https://example.org/chm#StrongVerbVIIb
chm:StrongVerbVIIb rdf:type owl:Class ;
                   rdfs:subClassOf chm:StrongVerbVII ;
                   rdfs:label "Strong verb class VIIb"@en .


#################################################################
#    Individuals
#################################################################

###  https://example.org/chm#biidan
chm:biidan rdf:type owl:NamedIndividual ,
                    ontolex:LexicalEntry ,
                    chm:StrongVerb ,
                    chm:StrongVerbI ;
           rdfs:label "bīdan"@ang ;
           ontolex:canonicalForm chm:biidan_inf ;
           ontolex:otherForm chm:biidan_pres-2sg_1 ,
                             chm:biidan_pres-2sg_2 ,
                             chm:biidan_pres-2sg_3 ,
                             chm:biidan_pres-3sg ,
                             chm:biidan_pret-3sg ,
                             chm:biidan_pret-pl_1 ,
                             chm:biidan_pret-pl_2 .


###  https://example.org/chm#biidan_inf
chm:biidan_inf rdf:type owl:NamedIndividual ,
                        ontolex:Form ;
               chm:rootVowel "ī" ;
               lexinfo:verbFormMood lexinfo:infinitive ;
               ontolex:writtenRep "bīdan"@ang .


###  https://example.org/chm#biidan_pres-2sg_1
chm:biidan_pres-2sg_1 rdf:type owl:NamedIndividual ,
                               ontolex:Form ;
                      chm:rootVowel "ī"^^xsd:string ;
                      lexinfo:number lexinfo:singular ;
                      lexinfo:person lexinfo:secondPerson ;
                      lexinfo:tense lexinfo:present ;
                      lexinfo:verbFormMood lexinfo:indicative ;
                      ontolex:writtenRep "bīst"@ang .


###  https://example.org/chm#biidan_pres-2sg_2
chm:biidan_pres-2sg_2 rdf:type owl:NamedIndividual ,
                               ontolex:Form ;
                      chm:rootVowel "ī"^^xsd:string ;
                      lexinfo:number lexinfo:singular ;
                      lexinfo:person lexinfo:secondPerson ;
                      lexinfo:tense lexinfo:present ;
                      lexinfo:verbFormMood lexinfo:indicative ;
                      ontolex:writtenRep "bīdst"@ang .


###  https://example.org/chm#biidan_pres-2sg_3
chm:biidan_pres-2sg_3 rdf:type owl:NamedIndividual ,
                               ontolex:Form ;
                      chm:rootVowel "ī"^^xsd:string ;
                      lexinfo:number lexinfo:singular ;
                      lexinfo:person lexinfo:secondPerson ;
                      lexinfo:tense lexinfo:present ;
                      lexinfo:verbFormMood lexinfo:indicative ;
                      ontolex:writtenRep "bītst"@ang .



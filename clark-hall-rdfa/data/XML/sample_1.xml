            rel="lexinfo:partOfSpeech" resource="lexinfo:verb" />
          <gram type="inflectionType" about="https://example.org/ch/CAS2.b_im_dan_entry"
            typeof="https://example.org/chm#StrongVerbI">
            <hi rend="superscript">1</hi>
          </gram>
        </gramGrp>
        <sense xml:id="CAS2.b_im_dan.1" about="https://example.org/ch/CAS2.b_im_dan.1_sense"
          typeof="ontolex:LexicalSense" rev="ontolex:sense"
          resource="https://example.org/ch/CAS2.b_im_dan_entry">
          <sense xml:id="CAS2.b_im_dan.1.1" about="https://example.org/ch/CAS2.b_im_dan.1.1_sense"
            typeof="ontolex:LexicalSense" rev="ontolex:sense"
            resource="https://example.org/ch/CAS2.b_im_dan_entry">
            <gramGrp>
              <gram type="valency" value="intransitive">(intr.)</gram>
            </gramGrp>
            <cit type="translationEquivalent" xml:lang="en">
              <quote about="https://example.org/ch/CAS2.b_im_dan.1.1_sense" property="rdfs:label"
                content="to stay, continue, live, remain, delay,">to stay, continue, live, remain,
                delay,</quote>
              <bibl type="attestation" source="#AO">
                <title>AO,</title>
              </bibl>
              <bibl type="attestation" source="#Ps">
                <title>Ps</title>
              </bibl>
            </cit>
          </sense>
          <metamark function="senseSeparator">:</metamark>
          <sense xml:id="CAS2.b_im_dan.1.2" about="https://example.org/ch/CAS2.b_im_dan.1.2_sense"
            typeof="ontolex:LexicalSense" rev="ontolex:sense"
            resource="https://example.org/ch/CAS2.b_im_dan_entry">
            <gramGrp>
              <gram type="valency" value="transitive">(tr.</gram>
            </gramGrp>
            <cit type="translationEquivalent" xml:lang="en">
              <gramGrp>
                <gram type="construction" value="usu. w. genitive">usu. w. g.</gram>
              </gramGrp>
              <pc>)</pc>
              <quote about="https://example.org/ch/CAS2.b_im_dan.1.2_sense" property="rdfs:label"
                content="wait for, await, expect,">wait for, await, expect,</quote>
              <bibl type="attestation" source="#Bl">
                <title>Bl,</title>
              </bibl>
              <bibl type="attestation" source="#Mt">
                <title>Mt;</title>
              </bibl>
              <bibl type="attestation" source="#AO">
                <title>AO,</title>
              </bibl>
              <bibl type="attestation" source="#CP">
                <title>CP</title>
              </bibl>
            </cit>
          </sense>
          <metamark function="senseSeparator">:</metamark>
          <sense xml:id="CAS2.b_im_dan.1.3" about="https://example.org/ch/CAS2.b_im_dan.1.3_sense"
            typeof="ontolex:LexicalSense" rev="ontolex:sense"
            resource="https://example.org/ch/CAS2.b_im_dan_entry">
            <cit type="translationEquivalent" xml:lang="en">
              <quote about="https://example.org/ch/CAS2.b_im_dan.1.3_sense" property="rdfs:label"
                content="endure, experience, find">endure, experience, find</quote>
            </cit>
          </sense>
          <metamark function="senseSeparator">:</metamark>
          <sense xml:id="CAS2.b_im_dan.1.4" about="https://example.org/ch/CAS2.b_im_dan.1.4_sense"
            typeof="ontolex:LexicalSense" rev="ontolex:sense"
            resource="https://example.org/ch/CAS2.b_im_dan_entry">
            <cit type="translationEquivalent" xml:lang="en">
              <quote about="https://example.org/ch/CAS2.b_im_dan.1.4_sense" property="rdfs:label"
                content="attain, obtain">attain, obtain</quote>

@prefix chm:     <https://example.org/chm#> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

chm:StrongVerbIShape a sh:NodeShape ;
  sh:targetClass chm:StrongVerbI ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "For Strong Verb Class I, the infinitive must have root vowel ī."@en ;
    sh:select """
      PREFIX chm:     <https://example.org/chm#>
      PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>

      SELECT $this
      WHERE {
        $this ontolex:canonicalForm ?f .
        ?f chm:rootVowel ?v .
        FILTER(?v != "ī")
      }
    """
  ] ;

  
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "For Strong Verb Class I, any 1sg past indicative form must have root vowel ā."@en ;
    sh:select """
      PREFIX chm:     <https://example.org/chm#>
      PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
      PREFIX lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#>

      SELECT $this
      WHERE {
        $this ontolex:otherForm ?f .
        ?f lexinfo:tense lexinfo:past ;
           lexinfo:person lexinfo:firstPerson ;
           lexinfo:number lexinfo:singular ;
           lexinfo:verbFormMood lexinfo:indicative ;
           chm:rootVowel ?v .
        FILTER(?v != "ā")
      }
    """
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "For Strong Verb Class I, any past participle form must have root vowel i."@en ;
    sh:select """
      PREFIX chm:     <https://example.org/chm#>
      PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
      PREFIX lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#>

      SELECT $this
      WHERE {
        $this ontolex:otherForm ?f .
        ?f lexinfo:tense lexinfo:past ;
           lexinfo:verbFormMood lexinfo:participle ;
           chm:rootVowel ?v .
        FILTER(?v != "i")
      }
    """
  ] .

chm:StrongVerbIIaShape
    a sh:NodeShape ;
    sh:targetClass chm:StrongVerbIIa ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Strong Verb IIa infinitive must have root vowel ēo." ;
        sh:select """
            PREFIX chm: <https://example.org/chm#>
            PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
            SELECT $this
            WHERE {
                $this ontolex:canonicalForm ?f .
                ?f chm:rootVowel ?v .
                FILTER (?v != "ēo")
            }
        """
    ] ;


    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Strong Verb IIa past 1sg must have root vowel ēa." ;
        sh:select """
            PREFIX chm: <https://example.org/chm#>
            PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
            PREFIX lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#>
            SELECT $this
            WHERE {
                $this ontolex:otherForm ?f .
                ?f lexinfo:tense lexinfo:past ;
                   lexinfo:person lexinfo:firstPerson ;
                   lexinfo:number lexinfo:singular ;
                   lexinfo:verbFormMood lexinfo:indicative ;
                   chm:rootVowel ?v .
                FILTER (?v != "ēa")
            }
        """
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Strong Verb IIa past 2sg must have root vowel ēa." ;
        sh:select """
            PREFIX chm: <https://example.org/chm#>
            PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
            PREFIX lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#>
            SELECT $this
            WHERE {
                $this ontolex:otherForm ?f .
                ?f lexinfo:tense lexinfo:past ;
                   lexinfo:person lexinfo:secondPerson ;
                   lexinfo:number lexinfo:singular ;
                   lexinfo:verbFormMood lexinfo:indicative ;
                   chm:rootVowel ?v .
                FILTER (?v != "ēa")
            }
        """
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Strong Verb IIa past plural must have root vowel u." ;
        sh:select """
            PREFIX chm: <https://example.org/chm#>
            PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
            PREFIX lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#>
            SELECT $this
            WHERE {
                $this ontolex:otherForm ?f .
                ?f lexinfo:tense lexinfo:past ;
                   lexinfo:number lexinfo:plural ;
                   lexinfo:verbFormMood lexinfo:indicative ;
                   chm:rootVowel ?v .
                FILTER (?v != "u")
            }
        """
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Strong Verb IIa past participle must have root vowel o." ;
        sh:select """
            PREFIX chm: <https://example.org/chm#>
            PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
            PREFIX lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#>

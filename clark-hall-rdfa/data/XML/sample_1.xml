      <entry xml:id="CAS2.b_im_dan" type="mainEntry" xml:lang="ang"
        about="https://example.org/ch/CAS2.b_im_dan_entry" typeof="ontolex:LexicalEntry">
        <form type="lemma" about="https://example.org/ch/CAS2.b_im_dan_entry"
